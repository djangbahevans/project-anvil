{
  "name": "languages",
  "publisher": "anvil-fixtures",
  "version": "0.0.1",
  "engines": { "vscode": "^1.90.0" },
  "contributes": {
    "languages": [
      {
        "id": "fixturelang",
        "aliases": ["Fixture Language", "fixture"],
        "extensions": [".fixture"],
        "filenames": ["fixturefile"],
        "filenamePatterns": ["fixture-*.cfg"],
        "firstLine": "^#!fixture",
        "configuration": "./fixture-configuration.json"
      },
      { "id": "python", "configuration": "./python-configuration.json" },
      {
        "id": "fixturebad",
        "extensions": [".fixturebad"],
        "configuration": "./bad-configuration.json"
      },
      {
        "id": "fixturemissing",
        "extensions": [".fixturemissing"],
        "configuration": "./missing-configuration.json"
      },
      {
        "id": "fixtureempty",
        "extensions": [".fixtureempty"],
        "configuration": "./empty-configuration.json"
      }
    ]
  }
}
